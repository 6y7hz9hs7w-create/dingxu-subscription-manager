page {
  --deep: #123d33;
  --green: #24594a;
  --ink: #17382f;
  --line: #dedbd0;
  --muted: #728079;
  --paper: #f7f5ee;
  --white: #fffefa;
  background: var(--paper);
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
}

view, text, button, input, picker, textarea { box-sizing: border-box; }
button::after { border: 0; }
.page { min-height: 100vh; padding: 32rpx 28rpx 64rpx; }
.eyebrow { color: #88938e; font-size: 19rpx; font-weight: 700; letter-spacing: 3rpx; }
.page-title { margin-top: 10rpx; font-family: Georgia, "Songti SC", serif; font-size: 48rpx; font-weight: 700; }
.page-lead { margin-top: 10rpx; color: var(--muted); font-size: 25rpx; line-height: 1.65; }
.panel { border: 1rpx solid var(--line); border-radius: 28rpx; background: var(--white); }
.primary-button { display: flex; align-items: center; justify-content: center; height: 88rpx; border-radius: 22rpx; background: var(--green); color: #fff; font-size: 27rpx; font-weight: 700; }
.secondary-button { display: flex; align-items: center; justify-content: center; height: 72rpx; border: 1rpx solid #cdd6d1; border-radius: 18rpx; background: #f8faf7; color: var(--green); font-size: 24rpx; font-weight: 700; }
.empty-state { padding: 64rpx 28rpx; text-align: center; }
.empty-icon { width: 76rpx; height: 76rpx; margin: 0 auto 18rpx; display: flex; align-items: center; justify-content: center; border: 2rpx dashed #aebbb5; border-radius: 50%; color: #709087; font-size: 36rpx; }
.empty-title { display: block; font-size: 27rpx; font-weight: 700; }
.empty-copy { display: block; margin: 10rpx auto 24rpx; color: var(--muted); font-size: 22rpx; line-height: 1.55; }
.service-mark { width: 76rpx; height: 76rpx; display: flex; align-items: center; justify-content: center; flex: none; border: 1rpx solid rgba(20, 50, 40, .06); border-radius: 22rpx; color: #1b362e; font-size: 27rpx; font-weight: 800; }
.loading { padding: 80rpx 0; color: var(--muted); text-align: center; font-size: 23rpx; }
