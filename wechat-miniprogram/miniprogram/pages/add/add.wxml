<view class="page add-page">
  <view class="intro">
    <text class="eyebrow">NEW SUBSCRIPTION</text>
    <text class="page-title">添加订阅</text>
    <text class="page-lead">记录下来，续费前替你留意。</text>
  </view>

  <form class="form-panel panel" bindsubmit="submit">
    <label class="field"><text>服务名称</text><input name="name" maxlength="60" placeholder="例如：腾讯视频 VIP" /></label>
    <label class="field"><text>订阅分类</text><picker range="{{categories}}" value="{{categoryIndex}}" bindchange="changeCategory"><view class="picker-value">{{categories[categoryIndex]}} <text>›</text></view></picker></label>
    <label class="field"><text>订阅金额</text><view class="money-input"><text>¥</text><input name="amount" type="digit" placeholder="0.00" /></view></label>
    <label class="field"><text>账单周期</text><picker range="{{billingCycles}}" value="{{billingIndex}}" bindchange="changeBilling"><view class="picker-value">{{billingCycles[billingIndex]}} <text>›</text></view></picker></label>
    <label class="field"><text>下次续费</text><picker mode="date" value="{{nextChargeDate}}" bindchange="changeDate"><view class="picker-value">{{nextChargeDate}} <text>›</text></view></picker></label>
    <label class="field"><text>提前提醒</text><picker range="{{reminderDays}}" value="{{reminderIndex}}" bindchange="changeReminder"><view class="picker-value">{{reminderDays[reminderIndex]}} 天前 <text>›</text></view></picker></label>

    <view class="field colors-field">
      <text>标记颜色</text>
      <view class="color-list">
        <view class="color-choice {{selectedColor === item ? 'selected' : ''}}" wx:for="{{colors}}" wx:key="*this" data-color="{{item}}" bindtap="chooseColor"><view style="background: {{item}}"></view></view>
      </view>
    </view>

    <label class="field"><text>备注</text><input name="note" maxlength="120" placeholder="例如：与家人共享" /></label>
    <button class="primary-button submit-button" form-type="submit" loading="{{submitting}}" disabled="{{submitting}}">添加并开启提醒</button>
  </form>
</view>
