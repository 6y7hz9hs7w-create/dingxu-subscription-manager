.intro { margin: 18rpx 5rpx 32rpx; display: flex; flex-direction: column; }
.form-panel { overflow: hidden; padding: 30rpx 28rpx; }
.field { width: 100%; min-width: 0; margin-bottom: 27rpx; display: flex; flex-direction: column; gap: 12rpx; color: #53645d; font-size: 23rpx; font-weight: 700; }
.field picker { width: 100%; min-width: 0; }
.field input, .picker-value, .money-input { width: 100%; min-width: 0; max-width: 100%; height: 84rpx; padding: 0 24rpx; display: flex; align-items: center; border: 1rpx solid #d9d7ce; border-radius: 18rpx; background: #faf9f5; color: var(--ink); font-size: 26rpx; font-weight: 400; }
.picker-value { justify-content: space-between; }
.picker-value text { color: #8b9690; font-size: 35rpx; }
.picker-placeholder { color: #98a19d; }
.custom-service-input { margin-top: 2rpx; }
.money-input { gap: 8rpx; }
.money-input > text { font-family: Georgia, serif; font-size: 30rpx; }
.money-input input { flex: 1; width: 0; min-width: 0; height: 80rpx; padding: 0; border: 0; background: transparent; }
.colors-field { margin-top: 4rpx; }
.color-list { height: 82rpx; padding: 0 16rpx; display: flex; align-items: center; justify-content: space-between; border: 1rpx solid #d9d7ce; border-radius: 18rpx; background: #faf9f5; }
.color-choice { width: 56rpx; height: 56rpx; display: flex; align-items: center; justify-content: center; border: 4rpx solid transparent; border-radius: 50%; }
.color-choice view { width: 46rpx; height: 46rpx; border: 2rpx solid rgba(23, 56, 47, .08); border-radius: 50%; }
.color-choice.selected { border-color: var(--green); }
.submit-button { margin-top: 12rpx; }
