.subscription-card.active .subscription-meta text:last-child { color: #174f3d; }
.subscription-card.cancelled .subscription-meta { margin-top: 20rpx; padding: 14rpx 16rpx; align-items: center; border: 1rpx solid #e8b9b1; border-radius: 16rpx; background: #fbdcd6; color: #963b30; font-weight: 800; }
