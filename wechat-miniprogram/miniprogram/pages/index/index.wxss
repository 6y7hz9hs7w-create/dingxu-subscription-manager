.search-empty { padding: 54rpx 24rpx; display: flex; align-items: center; flex-direction: column; gap: 9rpx; border: 2rpx dashed rgba(91,90,247,.22); border-radius: 30rpx; background: var(--surface-muted); text-align: center; }
