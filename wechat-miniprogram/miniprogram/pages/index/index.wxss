.brand-mark view + view { top: 27rpx; left: 18rpx; transform: rotate(138deg); }
.brand-name { margin-left: 10rpx; font-size: 34rpx; font-weight: 900; letter-spacing: 5rpx; }
.brand-caption { margin-left: 10rpx; color: #83948c; font-size: 16rpx; font-weight: 800; letter-spacing: 2rpx; }
.sync-chip { min-height: 56rpx; padding: 0 16rpx; display: flex; align-items: center; gap: 9rpx; flex: none; border-radius: 999rpx; background: #edf0ee; color: #68766f; font-size: 19rpx; font-weight: 700; }
.sync-chip view { width: 10rpx; height: 10rpx; border-radius: 50%; background: #aab1ad; }
.sync-chip.synced { background: #e6eee9; color: #47675c; }
