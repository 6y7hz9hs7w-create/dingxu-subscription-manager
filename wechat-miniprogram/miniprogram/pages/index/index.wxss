.brand-row { min-height: 84rpx; display: flex; align-items: center; justify-content: space-between; gap: 18rpx; }
.brand-lockup { min-width: 0; display: flex; align-items: center; }
.brand-lockup > view:last-child { min-width: 0; display: flex; flex-direction: column; gap: 1rpx; }
.brand-mark { width: 54rpx; height: 54rpx; position: relative; flex: none; }
