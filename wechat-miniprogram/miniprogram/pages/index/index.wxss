.subscription-sort { height: 88rpx; padding: 0 18rpx; display: flex; align-items: center; justify-content: center; gap: 10rpx; border-radius: 24rpx; color: var(--primary-strong); font-size: 20rpx; font-weight: 800; white-space: nowrap; }
