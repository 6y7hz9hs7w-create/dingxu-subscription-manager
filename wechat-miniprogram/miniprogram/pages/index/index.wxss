.hero-stats > view > text:first-child { color: #bdd0c8; font-size: 20rpx; font-weight: 700; }
.hero-stats > view:first-child > text:first-child { color: #59665e; }
.hero-stats > view > text:nth-child(2) { margin-top: 9rpx; font-size: 32rpx; font-weight: 800; }
.hero-stats > view > text:last-child { margin-top: 9rpx; color: #a9c0b7; font-size: 18rpx; }
.hero-stats > view:first-child > text:last-child { color: #667269; }
