.subscriptions-head { margin-top: 38rpx; }
.subscription-tools { margin-bottom: 18rpx; display: flex; align-items: stretch; gap: 12rpx; }
.subscription-search { min-width: 0; padding: 0 20rpx; display: flex; align-items: center; flex: 1; gap: 16rpx; border-radius: 24rpx; }
.subscription-search-icon { position: relative; width: 28rpx; height: 28rpx; flex: none; }
.subscription-search-icon::before { position: absolute; top: 2rpx; left: 2rpx; width: 15rpx; height: 15rpx; border: 3rpx solid var(--muted); border-radius: 50%; content: ""; }
.subscription-search-icon::after { position: absolute; right: 2rpx; bottom: 3rpx; width: 11rpx; height: 3rpx; border-radius: 3rpx; background: var(--muted); content: ""; transform: rotate(45deg); transform-origin: center; }
