.subscription-list { display: flex; flex-direction: column; gap: 18rpx; }
.subscription-card { padding: 26rpx; }
.subscription-card.batch-selected { border-color: var(--primary); border-width: 4rpx; box-shadow: 0 14rpx 30rpx rgba(91,90,247,.16); }
.batch-selector { width: 64rpx; height: 64rpx; display: flex; align-items: center; justify-content: center; flex: 0 0 64rpx; border: 2rpx solid #cbc8df; border-radius: 20rpx; background: rgba(255,255,255,.78); }
