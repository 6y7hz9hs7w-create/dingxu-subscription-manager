.activation-progress view { height: 100%; border-radius: inherit; background: #2b755c; }
.activation-footer { margin-top: 16rpx; display: flex; align-items: center; justify-content: space-between; color: #557066; font-size: 21rpx; font-weight: 750; }
.activation-footer button { min-width: 150rpx; height: 58rpx; margin: 0; padding: 0 20rpx; border-radius: 16rpx; background: #dfeee7; color: #245f4c; font-size: 20rpx; font-weight: 850; line-height: 58rpx; }
.pending-alert { margin-top: 24rpx; padding: 20rpx 22rpx; display: flex; align-items: center; justify-content: space-between; gap: 18rpx; border: 1rpx solid #e4b456; border-radius: 24rpx; background: #fff1be; color: #62470c; }
.pending-alert > view { min-width: 0; display: flex; flex-direction: column; }
.pending-alert > view text:first-child { font-size: 24rpx; font-weight: 900; }
.pending-alert > view text:last-child { margin-top: 5rpx; font-size: 20rpx; line-height: 1.45; }
.pending-alert > text { flex: none; padding: 9rpx 12rpx; border-radius: 12rpx; background: #74540d; color: #fff; font-size: 18rpx; font-weight: 850; }

/* 2026 UI refresh: calm ledger */
.brand-row { min-height: 88rpx; }
