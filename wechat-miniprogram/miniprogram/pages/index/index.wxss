.overview-hero { margin-top: 30rpx; padding: 34rpx 30rpx 28rpx; position: relative; overflow: hidden; border-radius: 36rpx; background: var(--deep); color: #fff; box-shadow: 0 22rpx 48rpx rgba(20, 61, 50, .16); }
.hero-orbit { position: absolute; border: 1rpx solid rgba(255,255,255,.08); border-radius: 50%; pointer-events: none; }
.orbit-one { width: 300rpx; height: 300rpx; top: -190rpx; right: -60rpx; }
.orbit-two { width: 190rpx; height: 190rpx; right: -110rpx; bottom: 30rpx; }
.hero-head { position: relative; display: flex; align-items: flex-start; justify-content: space-between; gap: 20rpx; }
