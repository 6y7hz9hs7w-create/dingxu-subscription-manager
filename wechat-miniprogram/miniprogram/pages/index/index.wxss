.card-actions { margin-top: 22rpx; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 11rpx; }
.card-actions.four-actions { grid-template-columns: repeat(4, minmax(0, 1fr)); }
.card-actions button { width: 100%; min-width: 0; height: 66rpx; margin: 0; padding: 0 4rpx; display: flex; align-items: center; justify-content: center; overflow: hidden; border-radius: 17rpx; background: #e9f0ec; color: #315c4d; font-size: 20rpx; font-weight: 800; line-height: 1.2; white-space: nowrap; }
