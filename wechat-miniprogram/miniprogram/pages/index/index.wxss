.subscription-card.paused .subscription-meta { margin-top: 20rpx; padding: 14rpx 16rpx; align-items: center; border: 1rpx solid #d9ae31; border-radius: 16rpx; background: #f7d96f; color: #684b0d; font-weight: 800; }
