.hero-stats { margin-top: 29rpx; padding-top: 24rpx; position: relative; display: grid; grid-template-columns: 1fr 1fr; gap: 14rpx; border-top: 1rpx solid rgba(255,255,255,.11); }
.hero-stats > view { min-width: 0; padding: 18rpx; display: flex; flex-direction: column; border-radius: 22rpx; background: rgba(255,255,255,.075); }
.hero-stats > view:first-child { background: var(--yellow); color: var(--ink); }
