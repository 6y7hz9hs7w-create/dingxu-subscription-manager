.subscription-top { min-width: 0; display: flex; align-items: center; gap: 16rpx; }
.subscription-meta { margin-top: 24rpx; padding-top: 20rpx; display: flex; justify-content: space-between; border-top: 1rpx solid #edf0ed; color: #7f8b85; font-size: 20rpx; }
