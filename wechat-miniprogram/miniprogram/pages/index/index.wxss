.auto-delete-note { margin-top: 12rpx; color: #93483e; font-size: 20rpx; font-weight: 700; text-align: right; }
.service-action-note { margin-top: 12rpx; color: #655f76; font-size: 20rpx; font-weight: 700; text-align: right; }
.pause-note { margin-top: 12rpx; color: #6c500d; font-size: 20rpx; font-weight: 800; text-align: right; }
.reminder-status { min-height: 66rpx; margin-top: 16rpx; padding: 8rpx 14rpx; display: flex; align-items: center; gap: 10rpx; border-radius: 16rpx; background: #f0f3f0; color: #65746d; font-size: 21rpx; }
.reminder-status > view { width: 11rpx; height: 11rpx; flex: none; border-radius: 50%; background: #adb3af; }
