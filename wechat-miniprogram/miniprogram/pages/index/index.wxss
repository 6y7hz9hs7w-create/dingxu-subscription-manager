.sync-chip.identified { background: #e8f0ec; color: #537065; }
.sync-chip.identified view { background: #72a58f; box-shadow: 0 0 0 5rpx rgba(79, 145, 116, .11); }
.sync-chip.signed-out { background: #fff3d6; color: #8a672b; }
