.batch-mode-button { width: auto; min-height: 58rpx; margin: 0; padding: 0 16rpx; border: 1rpx solid var(--line); border-radius: 16rpx; background: var(--white); color: var(--primary-strong); font-size: 20rpx; font-weight: 800; line-height: 58rpx; }
