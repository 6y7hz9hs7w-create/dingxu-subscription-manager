.service-action-guide-head > view { min-width: 0; display: flex; flex-direction: column; gap: 5rpx; }
.service-action-guide-head > view text:first-child { color: var(--ink); font-size: 24rpx; font-weight: 900; }
.service-action-guide-head > view text:last-child { color: var(--muted); font-size: 19rpx; line-height: 1.45; }
.service-action-guide-head button { width: 52rpx; height: 52rpx; margin: 0; padding: 0; flex: none; border-radius: 16rpx; background: rgba(255,255,255,.72); color: var(--muted); font-size: 28rpx; line-height: 52rpx; }
.service-action-guide-head button::after, .service-action-buttons button::after, .service-action-confirm button::after { display: none; }
.service-action-section { margin-top: 18rpx; display: flex; flex-direction: column; gap: 10rpx; }
.service-action-section > text { color: var(--ink); font-size: 20rpx; font-weight: 900; }
.service-action-section > view { display: grid; grid-template-columns: 34rpx minmax(0, 1fr); gap: 9rpx; color: var(--muted); font-size: 20rpx; line-height: 1.5; }
.service-action-section > view > text:first-child { width: 30rpx; height: 30rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #fff; color: var(--primary-strong); font-size: 17rpx; font-weight: 900; }
.service-action-buttons { margin-top: 20rpx; display: grid; grid-template-columns: 1fr 1.35fr; gap: 10rpx; }
.service-action-buttons button { min-height: 66rpx; margin: 0; padding: 0 12rpx; border-radius: 18rpx; background: #fff; color: var(--primary-strong); font-size: 19rpx; font-weight: 900; line-height: 66rpx; }
.service-action-buttons button.primary { background: var(--primary); color: #fff; }
.service-action-confirm { margin-top: 18rpx; padding-top: 18rpx; border-top: 1rpx solid rgba(91,90,247,.15); }
.service-action-confirm > text { color: var(--ink); font-size: 20rpx; font-weight: 900; }
.service-action-confirm > view { margin-top: 12rpx; display: grid; grid-template-columns: .85fr 1.4fr 1fr; gap: 8rpx; }
.service-action-confirm button { min-height: 62rpx; margin: 0; padding: 0 8rpx; border-radius: 16rpx; background: #fff; color: var(--ink); font-size: 17rpx; font-weight: 850; line-height: 1.2; }
.service-task-empty { margin-top: 18rpx; padding: 27rpx 18rpx; display: flex; align-items: center; flex-direction: column; gap: 7rpx; border-radius: 21rpx; background: #f5f4ff; text-align: center; }
.service-task-empty text:first-child { font-size: 22rpx; font-weight: 900; }
.service-task-empty text:last-child { color: var(--muted); font-size: 20rpx; line-height: 1.5; }

.renewal-flow { margin: 0 0 24rpx; padding: 28rpx; border: 0; border-radius: 34rpx; background: #fff; box-shadow: 0 15rpx 36rpx rgba(67,55,147,.1); }
.renewal-flow-head { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.renewal-flow-head > view { min-width: 0; display: flex; align-items: baseline; gap: 12rpx; }
.renewal-flow-head > view text:first-child { color: var(--ink); font-size: 31rpx; font-weight: 900; }
.renewal-flow-head > view text:last-child { color: var(--primary-strong); font-size: 20rpx; font-weight: 850; }
.renewal-flow-head button { width: auto; min-height: 58rpx; margin: 0; padding: 0 18rpx; border-radius: 16rpx; background: #f0eff8; color: var(--muted); font-size: 19rpx; font-weight: 850; line-height: 58rpx; }
.renewal-flow-head button::after { display: none; }
.renewal-flow-progress { height: 8rpx; margin-top: 20rpx; overflow: hidden; border-radius: 999rpx; background: #e9e8f2; }
.renewal-flow-progress view { height: 100%; border-radius: inherit; background: var(--primary); }
.renewal-flow-service { min-width: 0; margin-top: 26rpx; display: grid; align-items: center; grid-template-columns: 76rpx minmax(0, 1fr) auto; gap: 16rpx; }
.renewal-flow-logo { width: 76rpx; height: 76rpx; display: flex; align-items: center; justify-content: center; overflow: hidden; border-radius: 22rpx; }
.renewal-flow-logo.has-logo { background: #fff !important; }
.renewal-flow-logo image { width: 100%; height: 100%; border-radius: inherit; }
.renewal-flow-copy { min-width: 0; display: flex; flex-direction: column; gap: 6rpx; }
.renewal-flow-copy text:first-child { overflow: hidden; color: var(--ink); font-size: 28rpx; font-weight: 900; text-overflow: ellipsis; white-space: nowrap; }
.renewal-flow-copy text:last-child { overflow: hidden; color: var(--muted); font-size: 19rpx; text-overflow: ellipsis; white-space: nowrap; }
.renewal-flow-price { display: flex; align-items: baseline; color: var(--ink); }
.renewal-flow-price text:first-child { font-size: 30rpx; font-weight: 900; }
.renewal-flow-price text:last-child { font-size: 19rpx; font-weight: 750; }
.renewal-amount-row { min-height: 70rpx; margin-top: 22rpx; display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.renewal-amount-row > button { width: auto; margin: 0; padding: 0; background: transparent; color: var(--primary-strong); font-size: 20rpx; font-weight: 850; line-height: 1.3; }
.renewal-amount-row > button::after { display: none; }
.renewal-amount-row > view { min-width: 0; width: 230rpx; min-height: 66rpx; padding: 0 16rpx; display: flex; align-items: center; gap: 8rpx; border: 2rpx solid var(--primary); border-radius: 17rpx; box-sizing: border-box; }
.renewal-amount-row input { min-width: 0; flex: 1; color: var(--ink); font-size: 24rpx; font-weight: 850; }
.renewal-primary { width: 100%; min-height: 88rpx; margin: 8rpx 0 0; border-radius: 22rpx; background: var(--primary); color: #fff; font-size: 23rpx; font-weight: 900; line-height: 88rpx; }
.renewal-primary::after,
.renewal-secondary-actions button::after,
.renewal-postpone button::after,
.renewal-complete > button::after { display: none; }
.renewal-secondary-actions { margin-top: 12rpx; display: grid; grid-template-columns: .8fr 1.2fr; gap: 12rpx; }
.renewal-secondary-actions button { min-width: 0; min-height: 76rpx; margin: 0; padding: 0 10rpx; border-radius: 19rpx; background: var(--warning-soft); color: #795514; font-size: 20rpx; font-weight: 900; line-height: 1.25; }
.renewal-secondary-actions button.danger { background: var(--danger-soft); color: #a13f51; }
.renewal-postpone { margin-top: 22rpx; padding-top: 20rpx; border-top: 1rpx solid var(--line); }
.renewal-postpone > text { color: var(--muted); font-size: 19rpx; line-height: 1.4; }
.renewal-postpone > view { margin-top: 12rpx; display: grid; grid-template-columns: repeat(3, 1fr); gap: 10rpx; }
.renewal-postpone button { min-height: 64rpx; margin: 0; padding: 0; border-radius: 17rpx; background: #f0eff8; color: var(--ink); font-size: 19rpx; font-weight: 850; line-height: 64rpx; }
.renewal-complete { display: flex; align-items: stretch; flex-direction: column; gap: 18rpx; text-align: center; }
.renewal-complete-title { color: var(--ink); font-size: 31rpx; font-weight: 900; }
.renewal-complete-copy { color: var(--muted); font-size: 20rpx; line-height: 1.6; }
.renewal-complete > view { padding: 20rpx; display: flex; align-items: center; justify-content: space-between; border-radius: 20rpx; background: var(--primary-soft); color: var(--ink); }
.renewal-complete > view text:first-child { font-size: 20rpx; font-weight: 750; }
.renewal-complete > view text:last-child { color: var(--primary-strong); font-size: 28rpx; font-weight: 900; }
.renewal-complete > button { min-height: 76rpx; margin: 0; border-radius: 19rpx; background: var(--primary); color: #fff; font-size: 21rpx; font-weight: 900; line-height: 76rpx; }

.recent-actions { margin: 0 0 24rpx; padding: 27rpx; border: 0; border-radius: 34rpx; box-shadow: 0 15rpx 36rpx rgba(67,55,147,.08); }
.recent-actions-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 18rpx; }
.recent-actions-head > view:first-child { min-width: 0; display: flex; flex: 1; flex-direction: column; gap: 6rpx; }
.recent-actions-head > view:first-child > text:nth-child(2) { color: var(--ink); font-size: 31rpx; font-weight: 900; }
.recent-actions-head > view:first-child > text:last-child { color: var(--muted); font-size: 20rpx; line-height: 1.45; }
.recent-actions-count { min-width: 84rpx; min-height: 84rpx; padding: 0 10rpx; display: flex; align-items: center; justify-content: center; flex: none; flex-direction: column; border-radius: 25rpx; background: var(--primary-soft); color: var(--primary-strong); }
.recent-actions-count text:first-child { font-size: 29rpx; font-weight: 900; line-height: 1; }
.recent-actions-count text:last-child { margin-top: 6rpx; font-size: 18rpx; font-weight: 800; }
.recent-actions-toggle { width: 100%; min-height: 88rpx; margin: 18rpx 0 0; padding: 0; display: flex; align-items: center; justify-content: center; border: 0; border-radius: 22rpx; background: #f0efff; color: #4c44cf; font-size: 22rpx; font-weight: 900; line-height: 1.2; }
.recent-actions-toggle::after { display: none; }
.recent-actions-list { margin-top: 18rpx; border-top: 1rpx solid var(--line); }
.recent-action-row { min-width: 0; min-height: 94rpx; display: grid; align-items: center; grid-template-columns: 54rpx minmax(0, 1fr) auto; gap: 14rpx; border-bottom: 1rpx solid var(--line); }
.recent-action-logo { width: 54rpx; height: 54rpx; display: flex; align-items: center; justify-content: center; overflow: hidden; border-radius: 17rpx; }
.recent-action-logo.has-logo { border: 1rpx solid var(--line); background: #fff !important; }
.recent-action-logo image { width: 100%; height: 100%; border-radius: inherit; }
.recent-action-fallback { width: 28rpx; height: 32rpx; padding-top: 7rpx; display: flex; align-items: center; flex-direction: column; gap: 5rpx; border: 1rpx solid rgba(41,83,68,.28); border-radius: 7rpx; background: rgba(255,255,255,.68); }
.recent-action-fallback view:first-child { width: 8rpx; height: 8rpx; border-radius: 50%; background: #477b68; }
.recent-action-fallback view:last-child { width: 15rpx; height: 3rpx; border-radius: 999rpx; background: #8eaaa0; }
.recent-action-copy { min-width: 0; display: flex; flex-direction: column; gap: 5rpx; }
.recent-action-copy text:first-child { overflow: hidden; color: var(--ink); font-size: 21rpx; font-weight: 900; text-overflow: ellipsis; white-space: nowrap; }
.recent-action-copy text:last-child { font-size: 19rpx; font-weight: 750; }
.recent-action-copy .success { color: #168064; }
.recent-action-copy .warning { color: #916019; }
.recent-action-copy .danger { color: #ad4351; }
.recent-action-date { color: var(--muted); font-size: 19rpx; font-variant-numeric: tabular-nums; white-space: nowrap; }
.recent-actions-empty { margin-top: 18rpx; padding: 27rpx 18rpx; border-radius: 21rpx; background: #f5f4ff; color: var(--muted); font-size: 20rpx; line-height: 1.5; text-align: center; }
